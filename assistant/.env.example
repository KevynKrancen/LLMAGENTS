# Copy to assistant/.env and fill in. Only ANTHROPIC_API_KEY (or another
# provider key) + DATABASE_URL are required to chat; everything else unlocks
# its integration when set.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ASSISTANT_MODEL=anthropic:claude-sonnet-5
REVIEW_MODEL=anthropic:claude-haiku-4-5-20251001

# --- Identity ---
USER_ID=kevyn
USER_NAME=Kevyn
TIMEZONE=Asia/Jerusalem

# --- Database (docker-compose default) ---
DATABASE_URL=postgresql://hermes:hermes@localhost:5433/hermes

# --- Memory (optional: hosted mem0; empty = local pgvector) ---
MEM0_API_KEY=

# --- Web search (tavily.com) ---
TAVILY_API_KEY=

# --- Google: put OAuth client (Desktop) JSON at assistant/credentials.json,
#     then run: python -m assistant.google_auth
YOUTUBE_API_KEY=

# --- Apple Mail (appleid.apple.com -> app-specific password) ---
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# --- WhatsApp Cloud API (developers.facebook.com) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_PHONE=

# --- Sandbox: none | daytona | modal | e2b ---
SANDBOX_PROVIDER=none
DAYTONA_API_KEY=
E2B_API_KEY=

# --- Server auth: openssl rand -hex 32 (paste same value in the app Settings)
API_AUTH_TOKEN=

# --- APNs push (Apple Developer -> Keys -> APNs .p8) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.kevyn.hermes
APNS_USE_SANDBOX=true
